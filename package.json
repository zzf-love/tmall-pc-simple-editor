{
  "name": "tmall-pc-simple-editor",
  "private": true,
  "version": "1.4.0",
  "description": "一款本地运行的天猫/淘宝 PC 店铺图片热点装修工具",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node serve.mjs",
